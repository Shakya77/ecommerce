  "password": "password",
  "role": "admin"
}

### Register User
POST {{host}}/auth/register
Content-Type: application/json

{
  "name": "user",
  "email": "user@gmail.com",
  "password": "password",
  "role": "customer"
}

### Login User
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "admin@gmail.com",
  "password": "password"
}

